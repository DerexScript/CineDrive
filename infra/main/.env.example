# Copy to /opt/apps/cinedrive-production/.env and replace every placeholder.
# Preserve the existing local SESSION_SECRET and TOKEN_ENCRYPTION_KEY when
# importing the current database and encrypted Google Drive tokens.
IMAGE_TAG=bootstrap
NODE_ENV=production
# Explicitly allow the session cookie over HTTP for this personal deployment.
SESSION_COOKIE_SECURE=false
APP_NAME=CineDrive
APP_URL=http://<SERVER_IP>:52794
API_URL=http://<SERVER_IP>:52794/api
PUBLIC_URL=http://<SERVER_IP>:52794
DATABASE_URL=file:/app/data/app.db
SESSION_SECRET=replace-with-the-existing-local-session-secret
TOKEN_ENCRYPTION_KEY=replace-with-the-existing-local-64-character-hex-key
GOOGLE_CLIENT_ID=replace-with-the-existing-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-the-existing-google-client-secret
GOOGLE_REDIRECT_URI=http://<SERVER_IP>:52794/api/auth/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace-with-drive-root-folder-id
ADMIN_EMAIL=replace-with-the-existing-admin-email
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGIN=http://<SERVER_IP>:52794
TRUST_PROXY=true
APP_AUTH_MODE=multi-user
LIBRARY_SCAN_INTERVAL_HOURS=0
LOG_LEVEL=info
TMDB_API_KEY=replace-with-a-tmdb-api-key